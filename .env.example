# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realestate_texas
DB_USER=postgres
DB_PASSWORD=postgres

# Target Texas Markets (Comma-separated cities or counties)
TARGET_STATE=TX
TARGET_CITIES=Austin,Dallas,Houston,San Antonio,Fort Worth

# Scraping & Anti-Block Settings
REQUEST_TIMEOUT=15
DELAY_MIN_SECONDS=2
DELAY_MAX_SECONDS=5
MAX_RETRIES=3

# Optional: Scraper API / Proxy service (recommended for production scale on EC2)
# PROXY_URL=http://username:password@proxy-host:port
# RAPIDAPI_KEY=your_key_here
